# Copy to .env.local for local development. On Vercel these are already set for every environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Claim emails (server only). While testing, every claim goes to CLAIMS_TEST_INBOX and never to a medical aid.
# With no test inbox, sending refuses. CLAIMS_FROM_EMAIL defaults to Resend's test address, onboarding@resend.dev.
RESEND_API_KEY=
CLAIMS_TEST_INBOX=
CLAIMS_FROM_EMAIL=
